# Per-user config the app writes to its platform config dir; also ignored
# here in case TOUHOU_TAGGER_CONFIG_DIR points inside the repo.  Several hold
# personal paths (album_overrides is keyed by album directories; external_tools
# holds executable paths; storage_locations holds config/log dir paths).
auth.json
thwiki_auth.json
availability.json
external_tools.json
album_overrides.json
preferences.json
storage_locations.json
stats.json
stats_cache.json
stats_result.json
# Atomic-write temp files for any of the above.
*.json.tmp
cookies.txt
cookies.json
# The default Settings → Export configuration… filename.  Backups exclude
# cookies but can contain local library and executable paths.
touhou_tagger_backup.json

